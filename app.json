{
  "expo": {
    "name": "Plant Scanner",
    "slug": "jayden",
    "owner": "jayfv3s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.plantscanner"
    },
    "android": {
      "package": "com.example.plantscanner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera so you can photograph plants to identify them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can identify plants from your gallery.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "923fd923-a208-4585-b637-c168b1f06456"
      }
    }
  }
}
