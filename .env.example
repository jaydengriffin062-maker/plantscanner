# Copy to .env.local for local development, and add the same variables in
# Vercel: Project -> Settings -> Environment Variables. All are server-only;
# none are exposed to the browser (no NEXT_PUBLIC_ prefix).

# --- Plant identification (set at least one) ---

# Botanical Vision classifier served by ml/serve.py on a model host
# (e.g. http://localhost:8000 in development). Preferred when set.
INFERENCE_API_URL=
# Optional shared secret; must match INFERENCE_API_TOKEN on the inference service.
INFERENCE_API_TOKEN=

# Pl@ntNet fallback. Free key at https://my.plantnet.org/ (My account -> Settings -> API key).
PLANTNET_API_KEY=

# Optional: force a provider ("remote", "local" or "plantnet") instead of auto-selecting.
# By default the bundled model in /model runs inside the Vercel function (no setup needed).
IDENTIFY_PROVIDER=

# Plant information (description, common names, reference photos) comes from the
# public iNaturalist and Wikipedia APIs and needs no key.
